# setlist-stash environment configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# --- Branding (deployment-level override) ---
# Shown in the brand wordmark, page titles, and copy. Forks should set this
# to whatever they call their instance. Default: "Open Setlist Stash".
SITE_NAME=Open Setlist Stash

# One-line blurb used for the social-preview meta tags (og:description,
# twitter:description). Leave empty and it is derived from MCP_SUBJECT (or
# SITE_NAME) so no deployment ever advertises a band it does not serve.
SITE_DESCRIPTION=

# Optional path (under /static/) to an extra CSS file loaded after style.css.
# Leave empty for the clean platform default. Set to "themes/lot-poster.css"
# for the bundled Phish-fan Lot Poster look. Drop your own CSS into static/
# and point THEME_FILE at it to fully reskin.
THEME_FILE=

# --- Icons + social card ---
# Paths (under /static/) to this deployment's mark. Leave them all unset to
# keep the neutral platform placeholders. Set them to point at your own
# artwork; drop the files into static/ alongside the defaults rather than
# overwriting the defaults, because one image can serve several deployments
# and overwriting a shared file changes the mark on all of them.
# FAVICON_SVG=logo-t.svg
# FAVICON_PNG=logo-t-192.png
# APPLE_TOUCH_ICON=logo-t-192.png
# OG_IMAGE=og-image.png
# Optional multi-size .ico for clients that ignore the SVG. Unset renders no
# link tag at all.
# FAVICON_ICO=

# --- HTTP server ---
APP_HOST=0.0.0.0
APP_PORT=3706
LOG_FORMAT=json

# --- Postgres (game state only; NOT the phish-vault) ---
# When running via docker compose the host is `postgres` (service name).
PG_HOST=postgres
PG_PORT=5432
PG_DB=setlist_stash
PG_USER=setlist_stash
PG_PASSWORD=changeme

# --- mcp-phish read path ---
# Points at the mcp-phish container on the same nix1 host. The game NEVER
# reads phish-vault directly; everything routes through this MCP endpoint.
MCP_PHISH_URL=http://mcp-phish:3705/mcp
MCP_PHISH_TIMEOUT_SECONDS=15

# --- Public MCP docs (/connect page) ---
# Public-facing Streamable-HTTP URL advertised on /connect. Empty (default)
# hides the /connect nav link and serves a "no public MCP" panel.
MCP_PUBLIC_URL=
# Short human name for the band/catalog, used in the /connect copy
# (e.g. "Umphrey's McGee", "Phish"). Empty falls back to a generic phrase.
MCP_SUBJECT=
# Suggested local MCP-client alias in the `claude mcp add` / Claude Desktop
# examples. Empty (default) derives it from MCP_SUBJECT (first word, slugified:
# "Umphrey's McGee" -> umphreys, "Phish" -> phish). Set only to override.
MCP_ALIAS=

# --- Public MCP reverse proxy (/mcp) ---
# Internal docker-network URL of the upstream MCP endpoint that public /mcp
# traffic is proxied to (e.g. http://mcp-umphreys:3717/mcp). Empty (the
# default) does not mount /mcp at all, so the OSS image and the Phish demo
# never expose an upstream.
MCP_UPSTREAM_URL=
# Per-request connect/read timeout (seconds) for that upstream.
MCP_PROXY_TIMEOUT_SECONDS=30
# Per-IP fixed-window limit on the public /mcp proxy only (the game UI is never
# rate-limited). 0 disables it. Read TRUSTED_CLIENT_IP_HEADER below before
# trusting this number: which address counts as "the client" is what decides
# whether this is a limit or a decoration.
MCP_RATE_LIMIT_PER_MINUTE=60

# --- Client address resolution ---
# The ONE request header this deployment's edge is known to set AND to
# overwrite for inbound requests. Behind Cloudflare that is CF-Connecting-IP.
# Used for the /mcp rate-limit key and the magic-link audit trail.
#
# This is the setting that decides whether MCP_RATE_LIMIT_PER_MINUTE above
# does anything. Left empty the key is the socket peer, which behind a tunnel
# is the connector container -- so every caller in the world shares one bucket
# and the limiter fails closed for everyone once any one of them exceeds it.
# That is not a stricter limit; it is a limit keyed on the wrong thing.
#
# Empty is still the right DEFAULT, because it is unspoofable: a wrong-but-
# fixed address beats an address the caller chooses. Trusting a header is only
# sound when the app cannot be reached AROUND the edge that sets it, and that
# is an ingress property this code cannot check. So it stays an explicit
# operator declaration. Set it on any public deployment behind a proxy; leave
# it empty for LAN or Tailscale. See src/setlist_stash/client_addr.py.
TRUSTED_CLIENT_IP_HEADER=

# --- Showtime lock policy ---
# Default lock cutoff for any show: 22:00 ET on the show date. Per-show
# overrides live in the `prediction_locks` table.
DEFAULT_LOCK_TIME_LOCAL=22:00
DEFAULT_LOCK_TZ=America/New_York

# --- Auto-resolve cron ---
# Legacy knob kept for backwards-compat with .env files predating session 2.
RESOLVE_INTERVAL_MINUTES=30
# Inside-container resolver loop interval (seconds). Default 1800 (30 min).
RESOLVER_INTERVAL_SECONDS=1800
# How long after lock_at a show with no setlist gets stamped cancelled.
# Conservative: phish.net's setlist publish can lag overnight. Don't drop
# below 24 hours.
RESOLVER_CANCEL_AFTER_HOURS=72

# --- Show-night cadence (these three move together) ---
# While a show is live the resolver polls fast, scores the partial setlist, and
# publishes the setlist snapshot the browser then renders. The chain is:
#
#   upstream (phish.net) -> MCP hot-window cache -> resolver poll -> page
#
# A link is only as fast as the slowest one above it. Setting LIVE_REFRESH_
# SECONDS below RESOLVER_ACTIVE_INTERVAL_SECONDS is theater: the page will
# re-render data that has not changed. Likewise, an active interval shorter
# than the upstream MCP's hot-window cache TTL just re-reads a cached response
# (mcp-phish: HOT_WINDOW_CACHE_TTL_SECONDS, default 90s — lower it to at most
# the active interval if you speed this up).
#
# Fast poll cadence while a show window is open.
RESOLVER_ACTIVE_INTERVAL_SECONDS=60
# How long after lock the fast cadence stays on. Also bounds how long the live
# page keeps auto-refreshing.
RESOLVER_ACTIVE_WINDOW_HOURS=6
# !! COUPLED TO THE INTERVAL ABOVE !! A show finalizes when the encore has been
# seen and the track count has held steady for this many consecutive polls, so
# the real guard is the PRODUCT: 30 x 60s = 30 minutes of quiet. Halving the
# interval without doubling this halves the guard, and a gap between encore
# song 1 and encore song 2 starts reading as "final" — freezing an incomplete
# score permanently. Keep the product near 30 minutes.
RESOLVER_STABLE_POLLS_REQUIRED=30
# Browser refresh of the live show board (setlist + standings together, one
# request). Only active while the show is live; 0 disables it. Costs nothing
# upstream — the board reads the resolver's snapshot from Postgres, so extra
# viewers never reach phish.net.
LIVE_REFRESH_SECONDS=60

# --- Session / handle ---
# Anonymous handles get a signed cookie. Phase 4b adds magic-link email.
#
# !! THIS ONE IS ENFORCED. The app REFUSES TO START if this is left at the
# shipped default ("dev-only-do-not-use-in-prod") while COOKIE_SECURE=true or
# BASE_URL is https, because that key is published in this repo and baked into
# every ghcr.io image: anyone could forge a session cookie for any user.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every existing session out.
SESSION_SECRET=replace-me-with-a-long-random-string
# Send the `Secure` flag on session/flash cookies. Leave false for LAN/
# Tailscale-over-HTTP dev; set true on any HTTPS deployment (e.g. behind
# Cloudflare) so cookies are only ever sent over TLS.
COOKIE_SECURE=false

# --- Response security headers ---
# Master switch for the CSP / X-Frame-Options / X-Content-Type-Options /
# Referrer-Policy / Permissions-Policy / HSTS set. Leave true unless a proxy in
# front of the app sets its own Content-Security-Policy and you do not want two
# policies intersecting.
SECURITY_HEADERS=true
# Strict-Transport-Security max-age in seconds. Only ever sent when
# COOKIE_SECURE=true, so an HTTP LAN or Tailscale deployment never sends it.
# Set to 0 to suppress it on an HTTPS deployment too. Sticky: browsers that see
# it refuse plain HTTP to this host for the full duration, so lower it BEFORE
# any planned move off TLS, not after.
HSTS_MAX_AGE_SECONDS=31536000
# Extra origins for the CSP's script-src / connect-src, space separated. Needed
# when a CDN in front of the app injects a script the app never rendered, which
# no local test can detect. Cloudflare Web Analytics is the common case:
#   CSP_EXTRA_SCRIPT_SRC=https://static.cloudflareinsights.com
#   CSP_EXTRA_CONNECT_SRC=https://cloudflareinsights.com
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=

# --- Google SSO (Phase 1) ---
# Optional "Sign in with Google". Leave BOTH blank (the default) to keep the
# feature fully off: no Google buttons render and the /auth/google/* routes
# redirect home, so the OSS image and any self-host stay unaffected until you
# provision your own client.
#
# Setup: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# "Web application" client. Add the authorized redirect URI
# `{BASE_URL}/auth/google/callback` (e.g. https://your-domain/auth/google/callback,
# plus a http://localhost:PORT/auth/google/callback for local dev). Scopes are
# openid/email/profile (non-sensitive), so publish the consent screen to leave
# testing mode. BASE_URL (below) drives the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Magic-link email (Phase 4b) ---
# Provider modes:
#   disabled  (default) - email UI returns 503; no outbound traffic
#   log                 - logs full message to container logs (DEV ONLY;
#                         use this on nix1 until Gmail app password ships)
#   smtp                - sends via SMTP_* settings below
EMAIL_PROVIDER=disabled
# Base URL used to construct magic-link URLs AND the Google OAuth redirect
# URI (`{BASE_URL}/auth/google/callback`). On an HTTPS deployment set this to
# the public origin (e.g. https://your-domain); for LAN/Tailscale dev pick
# whatever your tailnet sees.
BASE_URL=http://nix1:3706
MAGIC_LINK_TTL_HOURS=24
MAGIC_LINK_MAX_OUTSTANDING=3
# SMTP settings (consulted only when EMAIL_PROVIDER=smtp). Gmail app
# password is the production target; set up mirrors zion-patching-
# notifications.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Smart-pick assist gate (Phase 4) ---
# Pre-lock: assist disabled (HUMAN-ONLY game). Post-lock + post-resolve:
# assist unlocks for retro analysis. Do NOT flip this to false casually.
ASSIST_PRE_LOCK=false

# --- Predict form show selection (operator override) ---
# When set, the predict form targets this show date (YYYY-MM-DD). When
# unset, the form picks the next future date from mcp__phish__recent_shows.
# Used during dev / Phase 4 testing when no real upcoming show is in the
# corpus.
# ADMIN_SHOW_DATE=2026-06-15
# ADMIN_SHOW_VENUE=Madison Square Garden
# ADMIN_SHOW_LOCATION=New York, NY
